# Prisma supports the native connection string format for PostgreSQL.
# See https://pris.ly/d/connection-strings
DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/afteratlas?schema=public"

# Auth.js (NextAuth) — generate with: npx auth secret
AUTH_SECRET="replace-with-a-random-secret"

# "Continue with Google" on /login and /register. Create an OAuth client at
# https://console.cloud.google.com/apis/credentials with authorized redirect
# URI <your-site>/api/auth/callback/google. Without these set, the button is
# still shown but signing in will fail.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Yelp Fusion API key, used to look up real vendors by zip code wherever
# the survey shows vendor recommendations. Without it, vendor sections fall
# back to a plain "search Yelp yourself" link. Get one at
# https://www.yelp.com/developers/v3/manage_app
YELP_API_KEY=""
