// After Atlas — Phase 1 data model
// Mirrors after-atlas-phase1-spec.md §1. The survey/checklist/vendor engine
// is generic over `EventType`; nothing here is death-specific — all
// death content is seeded data (see prisma/seed-data/death.json).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Event types
// ---------------------------------------------------------------------------

/// A supported life transition (death, divorce, layoff, ...). Phase 1 ships
/// one fully-populated row (`death`); additional rows can be added inactive
/// until their content is ready.
model EventType {
  id          String  @id
  name        String
  description String
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions       Question[]
  checklistItems  ChecklistItem[]
  gaps            Gap[]
  surveyResponses SurveyResponse[]
  articles        Article[]
  topicBuckets    TopicBucket[]

  @@map("event_types")
}

/// Which survey engine this row belongs to: post-death "what to do now",
/// or pre-death "are we prepared." Same engine, different question sets
/// and output framing (checklist vs. gap report).
enum SurveyMode {
  post_event
  planning
}

/// A state (or the general/fallback bucket) for the portions of the survey
/// that are legally state-specific — primarily intestate succession and a
/// handful of state-specific links/forms.
model Jurisdiction {
  id   String @id
  name String

  questions Question[]

  @@map("jurisdictions")
}

// ---------------------------------------------------------------------------
// Survey engine
// ---------------------------------------------------------------------------

/// A category the user can opt into at the topic-selection question,
/// grouping several `Question.category` values under one higher-level
/// choice (e.g. "Money & Property" containing Finances, Possessions,
/// Business, ...) so the picker stays a handful of choices instead of the
/// full flat category list. `SurveyResponse.selectedCategories` stores the
/// resolved category strings once chosen, not bucket ids — buckets are
/// only how the choice is presented, not a data relationship elsewhere.
model TopicBucket {
  id          String     @id @default(cuid())
  eventTypeId String
  eventType   EventType  @relation(fields: [eventTypeId], references: [id])
  mode        SurveyMode

  name       String
  order      Int
  categories String[]

  @@index([eventTypeId, mode])
  @@map("topic_buckets")
}

/// Mirrors the source spreadsheet's row types (see spec §6). Only
/// `topic_selection` currently gets distinct frontend treatment (the
/// bucket picker) — `bool`/`select`/`info` all render as a normal
/// QuestionCard today, but are modeled distinctly for fidelity to the
/// source data and in case that changes.
enum QuestionType {
  bool
  select
  info
  topic_selection
}

/// A single branching-survey question, scoped to an EventType + mode.
model Question {
  id          String       @id @default(cuid())
  eventTypeId String
  eventType   EventType    @relation(fields: [eventTypeId], references: [id])
  mode        SurveyMode
  type        QuestionType @default(bool)

  /// Null means the question applies in every jurisdiction (the vast
  /// majority) — set only for jurisdiction-specific content such as
  /// intestate succession.
  jurisdictionId String?
  jurisdiction   Jurisdiction? @relation(fields: [jurisdictionId], references: [id])

  prompt      String
  /// Optional help text shown alongside the prompt (definitions, resource links).
  description String?
  /// Grouping label for the section nav (e.g. "Home & Property"). Display only — not a sort key.
  category    String
  /// Global sequence across the whole eventType+mode question set (not scoped to category).
  order       Int
  section     String?

  /// This question's category's position in the actual authored tour
  /// through categories — NOT the same as sorting categories by their
  /// own `order`/uid range, since several categories are only reachable
  /// via a mid-sequence splice into an earlier uid range (e.g.
  /// Guardianship's block sits at low uids but is only entered from late
  /// in the tour, after Post-Death Benefits). Null for categories no
  /// TopicBucket covers (e.g. the mandatory intro). Shared by every
  /// question in the same category. Used only to redirect at a category
  /// boundary when advanceSurvey finds the natural next category wasn't
  /// selected — jump to the next-by-this-sequence category that was,
  /// rather than the uid-order fallback (which can't reach a category
  /// whose block sits earlier in uid space, like Guardianship's).
  categorySequence Int?

  /// Skip this question entirely if the referenced ChecklistItem was
  /// already triggered earlier in the same session (session-level dedup
  /// for content reachable via more than one path).
  skipIfChecklistItemShownId String?
  skipIfChecklistItemShown   ChecklistItem? @relation("QuestionSkipIfShown", fields: [skipIfChecklistItemShownId], references: [id])

  /// Rows sharing a non-empty value here render as one "select all that
  /// apply" screen instead of sequential single-question screens.
  /// Presentational grouping only — not a data relationship.
  multiselectGroup String?

  /// Set when this question's own copy references vendor recommendations
  /// directly (e.g. "below is a list of probate lawyers near you") rather
  /// than only surfacing them later via a triggered ChecklistItem/Gap.
  vendorCategoryId String?
  vendorCategory   VendorCategory? @relation(fields: [vendorCategoryId], references: [id])

  answerOptions AnswerOption[]

  branchesFrom QuestionBranch[] @relation("BranchQuestion")
  branchesTo   QuestionBranch[] @relation("BranchNextQuestion")

  checklistItemTriggers ChecklistItemTrigger[]
  gapTriggers           GapTrigger[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventTypeId, mode])
  @@map("questions")
}

/// One selectable answer to a Question. Modeled as its own table (rather
/// than embedded JSON) because branches and triggers reference a specific
/// answer option by id.
model AnswerOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  label String
  value String
  order Int

  branches              QuestionBranch[]
  checklistItemTriggers ChecklistItemTrigger[]
  gapTriggers           GapTrigger[]

  @@map("answer_options")
}

/// "Next question" branching logic for a given answer.
model QuestionBranch {
  id String @id @default(cuid())

  questionId String
  question   Question @relation("BranchQuestion", fields: [questionId], references: [id], onDelete: Cascade)

  answerOptionId String
  answerOption   AnswerOption @relation(fields: [answerOptionId], references: [id], onDelete: Cascade)

  /// Null means "skip to end of section."
  nextQuestionId String?
  nextQuestion   Question? @relation("BranchNextQuestion", fields: [nextQuestionId], references: [id])

  /// Questions to exclude entirely based on this answer (e.g. skip all
  /// "house" questions if the answer is "I don't own a house").
  skipQuestionIds String[]

  @@unique([questionId, answerOptionId])
  @@map("question_branches")
}

// ---------------------------------------------------------------------------
// Post-event output: checklist
// ---------------------------------------------------------------------------

/// Master library of possible checklist tasks for an EventType.
model ChecklistItem {
  id          String    @id @default(cuid())
  eventTypeId String
  eventType   EventType @relation(fields: [eventTypeId], references: [id])

  title        String
  description  String
  category     String
  relatedLinks String[]

  vendorCategoryId String?
  vendorCategory   VendorCategory? @relation(fields: [vendorCategoryId], references: [id])

  triggers ChecklistItemTrigger[]

  /// Questions that should be skipped once this item has already been triggered this session.
  skippedByQuestions Question[] @relation("QuestionSkipIfShown")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("checklist_items")
}

/// Which survey answers cause a ChecklistItem to appear in the final list.
model ChecklistItemTrigger {
  id String @id @default(cuid())

  checklistItemId String
  checklistItem   ChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  answerOptionId String
  answerOption   AnswerOption @relation(fields: [answerOptionId], references: [id], onDelete: Cascade)

  @@unique([checklistItemId, questionId, answerOptionId])
  @@map("checklist_item_triggers")
}

// ---------------------------------------------------------------------------
// Planning-mode output: gaps
// ---------------------------------------------------------------------------

/// The planning-mode equivalent of ChecklistItem: "this is missing from
/// your plan" rather than "do this task."
model Gap {
  id          String    @id @default(cuid())
  eventTypeId String
  eventType   EventType @relation(fields: [eventTypeId], references: [id])

  title       String
  description String
  category    String

  vendorCategoryId String?
  vendorCategory   VendorCategory? @relation(fields: [vendorCategoryId], references: [id])

  triggers GapTrigger[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gaps")
}

/// Which planning-mode survey answers cause a Gap to appear, mirroring
/// ChecklistItemTrigger.
model GapTrigger {
  id String @id @default(cuid())

  gapId String
  gap   Gap    @relation(fields: [gapId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  answerOptionId String
  answerOption   AnswerOption @relation(fields: [answerOptionId], references: [id], onDelete: Cascade)

  @@unique([gapId, questionId, answerOptionId])
  @@map("gap_triggers")
}

// ---------------------------------------------------------------------------
// Vendors
// ---------------------------------------------------------------------------

/// E.g. Realtors, Probate Lawyers, Estate Sale Providers, Funeral Homes,
/// Burial Plot Providers, Grief Counselors, Family Therapists, Financial
/// Advisors, Obituary Providers.
model VendorCategory {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?

  vendors        Vendor[]
  checklistItems ChecklistItem[]
  gaps           Gap[]
  questions      Question[]

  @@map("vendor_categories")
}

/// Phase 1: manually entered, no self-signup or bidding. `priority` is a
/// manual sort order standing in for future bid-based ranking.
model Vendor {
  id   String @id @default(cuid())
  name String

  description String
  imageUrl    String?
  priceRange  String?

  vendorCategoryId String
  vendorCategory   VendorCategory @relation(fields: [vendorCategoryId], references: [id])

  /// Zip codes this vendor services. A simple list for Phase 1; can be
  /// swapped for radius-based matching without a schema change (see
  /// serviceAreaDescription for a free-text stand-in on the radius side).
  zipCodes               String[]
  serviceAreaDescription String?

  websiteUrl      String
  reviewSourceUrl String?

  priority Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorCategoryId, priority])
  @@map("vendors")
}

// ---------------------------------------------------------------------------
// Users & auth (NextAuth-compatible)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  name          String?
  emailVerified DateTime?
  image         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  surveyResponses SurveyResponse[]
  ownedPlans      Plan[]           @relation("PlanOwner")
  planMemberships PlanMember[]

  @@map("users")
}

/// Standard Auth.js adapter model — OAuth provider linkage (Google/
/// Facebook are a nice-to-have add-on, not a Phase 1 blocker).
model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

/// Standard Auth.js adapter model.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@map("sessions")
}

/// Standard Auth.js adapter model (email verification / magic links).
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Survey responses
// ---------------------------------------------------------------------------

enum SurveyResponseStatus {
  in_progress
  completed
}

/// A user's in-progress or completed pass through a Question set.
model SurveyResponse {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  eventTypeId String
  eventType   EventType  @relation(fields: [eventTypeId], references: [id])
  mode        SurveyMode

  /// User-chosen name, set when starting the survey and editable later from the dashboard.
  title String?

  /// Collected alongside the name at survey start; used to scope Yelp
  /// vendor search results to the user's area.
  zipCode String?

  /// question_id -> answer_option_id
  answers Json @default("{}")

  status SurveyResponseStatus @default(in_progress)

  /// For resume: the question the user was last on.
  lastQuestionId String?

  /// Question ids visited so far, in first-encountered order. Drives the
  /// "back" button.
  history String[] @default([])

  /// Question.category values the user opted into at the topic-selection
  /// question (via TopicBucket), e.g. every category inside "Money &
  /// Property" if that bucket was checked. Empty until that question is
  /// answered. Drives both the section nav (shows exactly this set, all
  /// at once, rather than revealing categories as they're reached) and
  /// `advanceSurvey`'s skip logic (any category covered by some
  /// TopicBucket but not in this list is skipped entirely). Categories
  /// not covered by any bucket — e.g. the mandatory intro sequence — are
  /// never filtered, regardless of this list.
  selectedCategories String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan Plan?

  @@index([userId, eventTypeId, mode])
  @@map("survey_responses")
}

// ---------------------------------------------------------------------------
// Household planning collaboration (schema only — see spec §3)
// ---------------------------------------------------------------------------

/// A shared household planning effort (e.g. a married couple). In Phase 1
/// this always has exactly one member (the owner) and no invite flow;
/// the shape exists so collaboration doesn't require a migration later.
model Plan {
  id String @id @default(cuid())

  ownerUserId String
  ownerUser   User   @relation("PlanOwner", fields: [ownerUserId], references: [id])

  planningSurveyResponseId String         @unique
  planningSurveyResponse   SurveyResponse @relation(fields: [planningSurveyResponseId], references: [id])

  members PlanMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plans")
}

enum PlanMemberRole {
  owner
  member
  executor
}

enum PlanMemberStatus {
  invited
  accepted
}

/// Placeholder for future invited participants (spouse, kids, executor)
/// and their role/permissions on a Plan. Not implemented in Phase 1 —
/// included so the Plan table doesn't need reshaping when collaboration
/// (invite flow, roles, decision log) is built.
model PlanMember {
  id String @id @default(cuid())

  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  invitedEmail String?
  role         PlanMemberRole
  status       PlanMemberStatus @default(invited)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, invitedEmail])
  @@map("plan_members")
}

// ---------------------------------------------------------------------------
// Blog
// ---------------------------------------------------------------------------

model Article {
  id    String @id @default(cuid())
  slug  String @unique
  title String
  body  String

  publishedAt DateTime?

  eventTypeId String?
  eventType   EventType? @relation(fields: [eventTypeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("articles")
}
